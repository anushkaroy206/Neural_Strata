{
  "name": "Neural Strata — Mine Subsidence Early Warning",
  "short_name": "Neural Strata",
  "description": "AI-enabled smart mine subsidence monitoring and early warning platform. Offline-first operator console for surface mesh sensor networks.",
  "id": "/?app=neural-strata",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#0b1220",
  "theme_color": "#10233f",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["productivity", "utilities", "safety"],
  "icons": [
    {
      "src": "/pwa/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Regulator audit view",
      "short_name": "Regulator",
      "description": "Read-only console: the same live data with every control disabled",
      "url": "/?view=regulator",
      "icons": [{ "src": "/pwa/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI cascade",
      "short_name": "AI panel",
      "description": "Model 1 pattern classification and Model 2 time-to-failure",
      "url": "/?panel=ai",
      "icons": [{ "src": "/pwa/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
